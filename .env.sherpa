# sherpa-onnx 配置
# 本文件由 config_sherpa.py 直接加载（不是 .env），改完重启生效
SHERPA_NUM_THREADS=4
SHERPA_USE_INT8=true       # true=用 int8 量化版，速度快；false=用 fp32 版，精度高

# 模型存放路径。相对路径按"程序所在目录"解析，不依赖启动时的 cwd；
# 也可以写绝对路径，例如 D:/models
MODELS_DIR=./models

# 录音结果保存目录，同样支持相对/绝对路径。
# 不设的话默认放"程序目录\results"；如果那里写不进去（例如装到了
# Program Files 而当前不是管理员），会自动改存到"文档\SherpaASR\results"。
#SAVE_DIR=./results

CHUNK_SECONDS=3.0          # 每块时长
ENABLE_NOISE=false
VAD_AGGRESSIVENESS=2
VAD_FRAME_DURATION=30
